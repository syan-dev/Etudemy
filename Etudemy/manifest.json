{
  "manifest_version": 3,
  "name": "Etudemy",
  "version": "1.2.2",
  "description": "Sequential MCQ per 80-word chunk without opening transcript panel.",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["https://*.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["transcript.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html" },
  "web_accessible_resources": [
    {
      "resources": [
        "quiz-overlay.html",
        "quiz-overlay.css",
        "results-panel.html",    
        "results-panel.css",      
        "transcript.js"
      ],
      "matches": ["https://*.youtube.com/*"]
    }
  ]
}
