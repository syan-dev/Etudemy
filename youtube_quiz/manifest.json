{
  "manifest_version": 3,
  "name": "YouTube Quiz Overlay",
  "version": "1.3",
  "description": "Pause YouTube and show interactive quiz questions at specific timestamps.",
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png"
    }
  }
}
